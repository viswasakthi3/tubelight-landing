# ==============================================================================
# Tubelight Landing Environment Configuration Template (.env.example)
# Keep actual values in .env / .env.local (chmod 600, git-ignored).
# ==============================================================================

# Database: PostgreSQL connection for waitlist and durable landing records
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://<user>:<password>@127.0.0.1:15432/time_to_understand

# HTTP server port (default 8097 for Docker landing container)
PORT=8097

# Public URLs
NEXT_PUBLIC_SITE_URL=https://tubelight.net
SEARCH_SITE_URL=https://search.tubelight.net

# Backend communication
# Default public backend origin. A shared Docker network may instead use
# http://tubelight-backend:8787. Container localhost is not the host or another container.
T2U_API_URL=https://tubelight.net

# Shared Service Secret: Must match WEB_EXPLAIN_SECRET in backend .env
# Generated on server with: openssl rand -base64 36 (>= 32 chars)
WEB_EXPLAIN_SECRET=<openssl_rand_base64_36_matching_backend>

# Dedicated Cookie Signing Secret for HttpOnly tb_owner cookie
# Generated on server with: openssl rand -base64 36 (>= 32 chars)
# Falls back to WEB_EXPLAIN_SECRET if omitted, but dedicated key is recommended.
OWNER_COOKIE_SECRET=<openssl_rand_base64_36>

# Waitlist token signing secret (HMAC token for waitlist position checks)
WAITLIST_SECRET=<openssl_rand_base64_36>

# Billing: Razorpay Configuration (checkout / subscription)
RAZORPAY_KEY_ID=<razorpay_key_id>
RAZORPAY_KEY_SECRET=<razorpay_key_secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay_webhook_secret>
NEXT_PUBLIC_RAZORPAY_KEY_ID=<public_razorpay_key_id>
RAZORPAY_PLAN_ID=<razorpay_pro_plan_id>
RAZORPAY_MAX_PLAN_ID=<razorpay_max_plan_id>
MAX_CREDITS=375
MAX_PRICE_PAISE=199900

# Optional Notification Hooks
# WAITLIST_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
# RESEND_API_KEY=re_...
# WAITLIST_NOTIFY_TO=team@tubelight.net
# WAITLIST_NOTIFY_FROM=Tubelight <notifications@tubelight.net>
