# PostgreSQL Database URL for storing beta waitlist signups
# Format: postgres://username:password@host:port/database_name
DATABASE_URL=postgres://<user>:<password>@127.0.0.1:15432/time_to_understand

# Port to bind when running container or standalone server
PORT=8097

# Optional: forward every new beta signup to a webhook (Zapier, Make, Slack, your CRM...)
# WAITLIST_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxx/yyyyy

# Optional: email yourself on each signup via Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# WAITLIST_NOTIFY_TO=you@example.com
# WAITLIST_NOTIFY_FROM=Tubelight <beta@yourdomain.com>

# Public site URL, used for metadata / OG tags
NEXT_PUBLIC_SITE_URL=https://tubelight.net

